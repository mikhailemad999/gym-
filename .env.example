# ========================================
# AthleteCare Pro — Environment Variables
# ========================================

# Application
NODE_ENV=development
APP_NAME=AthleteCare Pro
APP_URL=http://localhost:3000
API_URL=http://localhost:3001

# ---- Database (MySQL) ----
DB_HOST=localhost
DB_PORT=3305
DB_USERNAME=root
DB_PASSWORD=1234
DB_DATABASE=athletecare_pro

# ---- Redis ----
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ---- JWT ----
JWT_SECRET=CHANGE_ME_TO_A_SECURE_RANDOM_STRING_64_CHARS
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# ---- File Storage ----
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760

# ---- Email (SMTP) ----
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=noreply@athletecare.pro
SMTP_PASSWORD=your-smtp-password
SMTP_FROM="AthleteCare Pro <noreply@athletecare.pro>"

# ---- AI Provider ----
AI_PROVIDER=openai
AI_API_KEY=your-ai-api-key
AI_MODEL=gpt-4o
AI_MAX_TOKENS=4096
AI_TEMPERATURE=0.7

# ---- Payment Provider ----
PAYMENT_PROVIDER=stripe
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# ---- Frontend ----
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1
NEXT_PUBLIC_APP_NAME=AthleteCare Pro
NEXT_PUBLIC_SITE_URL=http://localhost:3000
